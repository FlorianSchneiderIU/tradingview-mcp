# ===========================================================================
# heatmap-forward-bot — forward-tests the heatmap setup signal on a SEPARATE
# Bybit DEMO account. Copy to bot/.env.heatmap_demo and fill in the keys.
# This is the ONLY env_file for the service, so it MUST carry its own keys —
# it can never accidentally use another bot's account.
# Start:  docker compose up -d --build heatmap-forward-bot
# ===========================================================================

# --- SEPARATE Bybit DEMO account (create a fresh demo API key) --------------
HEATMAP_FWD_BYBIT_API_KEY=your_demo_api_key_here
HEATMAP_FWD_BYBIT_API_SECRET=your_demo_api_secret_here
HEATMAP_FWD_BYBIT_DEMO=true
# HEATMAP_FWD_LIVE_CONFIRM=false   # must be true to trade with DEMO=false (don't)
HEATMAP_FWD_TRADING_ENABLED=true   # false = idle (no orders)

# --- Risk / sizing ----------------------------------------------------------
HEATMAP_FWD_RISK_USDT=10           # risk per trade; qty = RISK / |entry-SL| (hitting SL ≈ -1R)
HEATMAP_FWD_MAX_OPEN=20            # max concurrent positions (one per symbol)
HEATMAP_FWD_LEVERAGE=10           # order leverage (sizing is risk-based, not leverage-based)
HEATMAP_FWD_HEDGE_MODE=true       # true = hedge account (long positionIdx=1, short=2); false = one-way
HEATMAP_FWD_TP_SPLIT=50,50        # scale out: % at [TP1, TP2] as native partial brackets; "100" = single TP1
HEATMAP_FWD_MIN_CONFIDENCE=1      # 1=take any valid setup; 2/3 = stricter (bias+CVD / +skew aligned)
HEATMAP_FWD_COOLDOWN_SECONDS=1800 # per-symbol wait after a close before re-entering
HEATMAP_FWD_BREAKEVEN=true        # after first TP fills, move remaining stop to breakeven (avg entry)
HEATMAP_FWD_TAKER_FEE_PCT=0.00055 # taker fee per side (Bybit linear default 0.055%); entry+BE-exit are both taker
HEATMAP_FWD_BE_OFFSET_PCT=0.0004  # cushion ON TOP of round-trip fees (funding+slippage). BE = entry +/- (2*taker + this)
HEATMAP_FWD_MAX_TRANCHES=3        # pyramiding: max same-direction adds per coin (each its own partial bracket)
HEATMAP_FWD_ADD_COOLDOWN_SECONDS=900  # min spacing between pyramid adds on the same coin/side
# HEATMAP_FWD_SYMBOLS=             # blank = the heatmap-bot universe; or a CSV subset
# HEATMAP_FWD_POLL_SECONDS=30

# --- Telegram fill notifications (optional; copy from .env.heatmap) ----------
# Without these, trades still log to docker logs + logs/heatmap_forward_ledger.jsonl
# and /forward in the main Telegram bot summarizes the ledger.
HEATMAP_TG_BOT_TOKEN=
HEATMAP_TG_ALLOWED_UIDS=
