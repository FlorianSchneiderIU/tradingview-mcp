# ── Copy this file to .env and fill in your credentials ───────────────────────
# docker-compose.yml loads bot/.env explicitly via env_file.

# ── API credentials ────────────────────────────────────────────────────────────
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Telegram signal notifications. Leave blank to disable.
# Telegram forum topics are supported as <chat_id>_<message_thread_id>,
# for example -1003755718647_118.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ACCEPTED_SIGNALS_CHAT_ID=
TELEGRAM_REJECTED_SIGNALS_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=

# ── Trading mode ───────────────────────────────────────────────────────────────
# true  → Bybit Demo Trading  (api-demo.bybit.com) — simulated funds, real market data
# false → Live Trading        (api.bybit.com)       — REAL FUNDS, use with caution!
BYBIT_DEMO=true
# Required explicit guard for live mode. Leave false in demo.
# If BYBIT_DEMO=false and this is not true, the bot exits before trading startup.
LIVE_TRADING_CONFIRM=false

# ── Risk / sizing ──────────────────────────────────────────────────────────────
# Target account loss at the initial stop-loss as a fraction of equity.
# 0.01 = a trade hitting SL should lose about 1% of equity.
NOTIONAL_PCT=0.01
MIN_STOP_DISTANCE_PCT=0.001
TAKER_FEE_RATE=0.00055
MAX_FEE_TO_PRICE_RISK=0.25
ORDER_LEVERAGE_BUFFER=2.0
WS_STALE_SECONDS=900
PUBLIC_WS_STRATEGY_CHUNK_SIZE=24

# Maximum number of positions open simultaneously across all strategies.
MAX_OPEN_POSITIONS=5
MATRIX_MAX_SYMBOL_POSITIONS=-1
MATRIX_DEDUP_SECONDS=0
MATRIX_OPI_COOLDOWN_SECONDS=1800
MATRIX_MAX_RISK_MULTIPLIER=1.05
MAX_CLUSTER_A=3

# Drawdown guards. MAX_WEEKLY_DD=0 disables the weekly guard.
MAX_DAILY_DD=0.05
MAX_WEEKLY_DD=0.0
DD_CLOSE_POSITIONS_ON_BREACH=true

# Public market-data WS. Keep false in demo mode because Bybit demo public WS
# can return 404 for linear kline streams.
BYBIT_PUBLIC_WS_DEMO=false

# Private order/position WS for fill notifications. Demo private WS is available.
ENABLE_PRIVATE_ORDER_WS=true
BYBIT_PRIVATE_WS_DEMO=true
TELEGRAM_NOTIFY_ENTRY_FILLS=false
PRIVATE_POSITION_ENTRY_DEBOUNCE_SECONDS=10
PROTECTION_AUDIT_SECONDS=300
# Admin-only open-order sanity audit interval. 0 disables.
OPEN_ORDER_AUDIT_SECONDS=300
DAILY_HEARTBEAT_UTC_HOUR=0
DAILY_HEARTBEAT_UTC_MINUTE=5
MAX_DAILY_LOSSES_PER_STRATEGY=0
MAX_DAILY_LOSSES_PER_SYMBOL=0
MAX_CONSECUTIVE_LOSSES_PER_STRATEGY=0
MAX_CONSECUTIVE_LOSSES_PER_SYMBOL=0

# Reinforcement-learning execution sidecar.
# Use a separate Bybit Demo Trading account/sub-account for these credentials.
RL_EXECUTION_URL=http://rl-exec-bot:8090/v1/signals
RL_EXECUTION_TIMEOUT_SECONDS=1.0
RL_EXECUTION_QUEUE_SIZE=2000
# Leave blank to let the primary bot execute accepted signals while still
# forwarding signal telemetry to the RL sidecar.
RL_ONLY_STRATEGIES=
RL_DAILY_HEARTBEAT_UTC_HOUR=0
RL_DAILY_HEARTBEAT_UTC_MINUTE=5
# Defaults to TELEGRAM_BOT_TOKEN and TELEGRAM_ADMIN_CHAT_ID when blank.
RL_TELEGRAM_BOT_TOKEN=
RL_TELEGRAM_CHAT_ID=
RL_BYBIT_API_KEY=your_rl_demo_api_key_here
RL_BYBIT_API_SECRET=your_rl_demo_api_secret_here
RL_BYBIT_DEMO=true
# Keep false to collect decisions without placing RL-account orders.
RL_TRADING_ENABLED=false
RL_DEFAULT_RISK_USDT=100
RL_MIN_ACTION_TO_TRADE=0.05
RL_RISK_MULTIPLIERS=
RL_INITIAL_ACTION=0.10
RL_EXPLORATION_RATE=0.02
RL_EXPLORATION_MAX_ACTION=0.25
RL_TP_SCALE_MAX=10
RL_INITIAL_TP_SCALE=3
RL_TRAINING_EXAMPLES_PATH=/app/rl/training_examples.jsonl
RL_PRETRAIN_ON_START=false
RL_PRETRAIN_PATH=
# Rolling trade-history features for strategy/room slices.
# Use fewer windows if you want a less correlated feature set.
RL_ROLLING_WINDOW_SHORT=5
RL_ROLLING_WINDOW_MEDIUM=20
RL_ROLLING_WINDOW_LONG=50
RL_ROLLING_HISTORY_MAXLEN=200

# BTC weekday/Monday/regime 1R edge bot.
# Uses the research CSV mounted by docker-compose.yml and sends Telegram
# signals for statistically filtered candidate entry hours. Trading is off
# by default; use a separate Bybit Demo Trading account when enabling it.
WEEKDAY_EDGE_SYMBOL=BTCUSDT
WEEKDAY_EDGE_CATEGORY=linear
WEEKDAY_EDGE_STRATEGY_NAME=weekday_1r_edge
WEEKDAY_EDGE_PUBLIC_WS_DEMO=false
WEEKDAY_EDGE_TELEGRAM_BOT_TOKEN=
WEEKDAY_EDGE_TELEGRAM_CHAT_ID=
WEEKDAY_EDGE_BYBIT_API_KEY=your_weekday_edge_demo_api_key_here
WEEKDAY_EDGE_BYBIT_API_SECRET=your_weekday_edge_demo_api_secret_here
WEEKDAY_EDGE_BYBIT_DEMO=true
WEEKDAY_EDGE_TRADING_ENABLED=false
WEEKDAY_EDGE_RISK_USDT=100
WEEKDAY_EDGE_STATS_PATH=/app/weekday_1r_eval/btcusdt_20210525_20260525_1r_weekday_entry_hour_meaningful.csv
WEEKDAY_EDGE_LEDGER_PATH=/app/logs/weekday_edge_signals.jsonl
WEEKDAY_EDGE_MIN_TRADES=100
WEEKDAY_EDGE_MIN_WEEKS=40
WEEKDAY_EDGE_MIN_AVG_R_CI_LOW=0.0
WEEKDAY_EDGE_REQUIRE_FDR=false
WEEKDAY_EDGE_MAX_Q_VALUE=0.10
WEEKDAY_EDGE_CONTEXT_FAMILIES=
WEEKDAY_EDGE_RR=1.0
WEEKDAY_EDGE_SL_ATR_MULTIPLE=2.0
WEEKDAY_EDGE_ATR_LENGTH=14
# Fallback only; live RL payloads use the selected rule's historical win_rate.
WEEKDAY_EDGE_RL_PROBABILITY=0.55
WEEKDAY_EDGE_RL_THRESHOLD=0.50
WEEKDAY_EDGE_RL_EXECUTION_URL=http://rl-exec-bot:8090/v1/signals
WEEKDAY_EDGE_RL_EXECUTION_TIMEOUT_SECONDS=1.0
WEEKDAY_EDGE_RL_EXECUTION_QUEUE_SIZE=1000

# Matrix signal listener + dedicated matrix RL execution sidecar.
# In docker-compose, matrix-bot forwards to matrix-rl-exec-bot over
# MATRIX_RL_EXECUTION_URL. Keep the RL_* credentials below in .env.matrix so
# matrix sidecar execution uses the matrix Bybit account consistently.
MATRIX_HOMESERVER=
MATRIX_ACCESS_TOKEN=
# Comma-separated list of room IDs to listen to (e.g., !roomid1:server,!roomid2:server)
# Leave blank to listen to all joined rooms. Supports legacy MATRIX_ROOM_ID for single room.
MATRIX_ROOM_IDS=
# Matrix sidecar execution credentials/toggle (optional aliases; falls back to BYBIT_API_* if unset)
RL_BYBIT_API_KEY=
RL_BYBIT_API_SECRET=
RL_TRADING_ENABLED=false
MATRIX_SIGNAL_SENDER=
MATRIX_POST_REPLY=true
MATRIX_RL_EXECUTION_URL=http://matrix-rl-exec-bot:8091/v1/signals
MATRIX_RL_EXECUTION_TIMEOUT_SECONDS=1.0
MATRIX_RL_EXECUTION_QUEUE_SIZE=1000
# Persisted event_id -> decision/order/entry mapping used for precise exit targeting.
RL_ENTRY_REFS_STATE_PATH=/app/logs/rl_entry_refs.json
# Cleanup for persisted RL entry refs.
# Records older than this are pruned on load/save/update (0 disables age pruning).
RL_ENTRY_REFS_MAX_AGE_DAYS=14
# Hard cap for number of refs retained after pruning.
RL_ENTRY_REFS_MAX_ENTRIES=5000
# Cache TTL (seconds) for Bybit-derived Matrix HTF features (ret_1h_dir, ret_4h_dir, symbol_vol_mult)
MATRIX_MARKET_FEATURE_CACHE_SECONDS=30
# Matrix sidecar Bybit account uses the RL_* keys defined above.

# Strategy toggles.
ENABLE_TURTLE_SOUP=true
TURTLE_SYMBOLS=BNBUSDT,TAOUSDT,LINKUSDT,BTCUSDT,ETHUSDT,SOLUSDT
ENABLE_WOLFE_WAVE=true
WOLFE_WAVE_SYMBOLS=BTCUSDT,ETHUSDT,LINKUSDT,LTCUSDT,SOLUSDT,UNIUSDT,XRPUSDT
WOLFE_WAVE_CONFIG_PATH=/app/configs/wolfe_wave_configs.json
WOLFE_WAVE_WARMUP_BARS=20000
ENABLE_WOLFE_WAVE_V2=false
WOLFE_WAVE_V2_SYMBOLS=
WOLFE_WAVE_V2_CONFIG_PATH=/app/configs/wolfe_wave_v2_strong_configs.json

# Keep false for fail-closed behavior: if a Million Moves symbol has use_dt=true
# but no accepted DT model file, do not trade it as trail-only.
ALLOW_MM_WITHOUT_DT=false

ENABLE_SESSION_ORB=true
SESSION_ORB_SYMBOLS=ETHUSDT,WIFUSDT,NEARUSDT,ENAUSDT,OPUSDT,ONDOUSDT
SESSION_ORB_THRESHOLD=0.50
SESSION_ORB_WARMUP_BARS=20000
SESSION_ORB_BLOCK_WEEKEND_SESSIONS=asia,london
