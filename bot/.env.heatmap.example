# ===========================================================================
# heatmap-bot — Bybit liquidity heatmap service
# Copy to bot/.env.heatmap. This is the ONLY env_file for the heatmap-bot
# service. The bot reads PUBLIC market data only, so API keys are NOT required.
# ===========================================================================

# --- Tracked universe (THE coins we care about) -----------------------------
# Fixed comma-separated list of Bybit linear perps. These are the coins the
# heatmap is built for; membership is stable so the stored history stays
# consistent (no coins silently dropping in/out). Paste the universe you trade.
# If left blank, the bot falls back to the dynamic top-50 by 24h turnover.
HEATMAP_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,LTCUSDT,ATOMUSDT,NEARUSDT,FILUSDT,ARBUSDT,OPUSDT,INJUSDT,SUIUSDT

# --- Layer toggles + knobs (optional; full defaults in configs/heatmap_configs.json) ---
# Layer 1 order-book liquidity:
# HEATMAP_ORDERBOOK_ENABLED=true
# HEATMAP_DEPTH=200                       # order-book WS depth: 1 / 50 / 200 / 500
# HEATMAP_OB_MIN_LIFETIME_SECONDS=3       # drop levels younger than this (spoof filter)
# Layer 2 actual liquidations (Bybit allLiquidation stream):
# HEATMAP_LIQUIDATIONS_ENABLED=true
# Layer 4 volume profile (buy/sell delta from the publicTrade stream):
# HEATMAP_VOLUME_PROFILE_ENABLED=true
# HEATMAP_VP_BIN_PCT=0.0015            # geometric price-bin width
# HEATMAP_VP_SEED_HOURS=168            # kline-seeded total-volume history (no split)
# HEATMAP_VP_RETENTION_HOURS=192       # keep 8 days of hourly buckets
# Layer 3 predictive liquidation model:
# HEATMAP_PREDICTIVE_ENABLED=true
# HEATMAP_USE_OI=true                     # size new positions from dOI (vs candle turnover)
# HEATMAP_MMR=0.005                       # maintenance margin used in the liq-price formula
# HEATMAP_LEVERAGES=2,3,5,10,20,25,50,75,100
# HEATMAP_LEVERAGE_WEIGHTS=0.05,0.07,0.12,0.22,0.24,0.12,0.10,0.05,0.03
# Auto-calibration — Bayesian Dirichlet fit of leverage weights to actual liquidations:
# HEATMAP_CALIBRATION_ENABLED=true
# HEATMAP_CALIBRATION_INTERVAL_HOURS=24
# HEATMAP_CALIB_WINDOW_HOURS=72        # window of NEW actual events folded in per run
# HEATMAP_CALIB_TF=5m                  # timeframe whose candles attribute events to buckets
# HEATMAP_CALIB_MIN_EVENTS=200         # skip if fewer real liquidations explained (anti-noise)
# HEATMAP_CALIB_PRIOR_STRENGTH=300     # Dirichlet prior mass (higher = weights move slower)
# HEATMAP_CALIB_FORGET=1.0             # decay of accumulated counts per run (<1 = regime adaptation)

# --- Optional Bybit keys (UNUSED today; public data needs no auth) ----------
# HEATMAP_BYBIT_API_KEY=
# HEATMAP_BYBIT_API_SECRET=

# --- Heatmap Telegram bot (heatmap-telegram-bot service) ---------------------
# Own bot token from @BotFather (falls back to TELEGRAM_BOT_TOKEN if blank).
HEATMAP_TG_BOT_TOKEN=
# Comma-separated Telegram USER ids allowed to query heatmaps. Anyone not listed
# is ignored. Get your id from @userinfobot. REQUIRED — empty means nobody.
HEATMAP_TG_ALLOWED_UIDS=
# Optional: who receives watchdog/stale-stream alerts (defaults to ALLOWED_UIDS).
# HEATMAP_TG_ADMIN_UIDS=
# Proactive alerts + watchdog (heatmap-bot sends these directly):
# HEATMAP_ALERTS_ENABLED=true
# HEATMAP_CASCADE_MIN_USD=1000000      # liquidation burst threshold (per cascade window)
# HEATMAP_PROXIMITY_PCT=0.005          # alert when price within 0.5% of a watched level
# HEATMAP_WATCHDOG_ENABLED=true        # reconnect + alert if a WS stream goes stale
# Optional render knobs:
# HEATMAP_TG_DEFAULT_LIMIT=180   # snapshots (time columns) per image
# HEATMAP_TG_GRID_ROWS=140       # price rows in the rendered grid

# DB path, config path, API host/port and LOG_DIR are set in docker-compose.yml
# under the heatmap-bot service, so this file only needs the universe + knobs above.
