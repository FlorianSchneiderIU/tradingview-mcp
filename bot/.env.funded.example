# Funded Wolfe direct execution credentials.
# Copy to bot/.env.funded and fill in the funded Bybit account keys locally.
# This is consumed by matrix-bot directly; it does not start another RL sidecar.

MATRIX_FUNDED_BYBIT_API_KEY=
MATRIX_FUNDED_BYBIT_API_SECRET=
MATRIX_FUNDED_BYBIT_DEMO=false

# Keep false until startup logs confirm the intended account and filters.
MATRIX_FUNDED_EXECUTION_ENABLED=false

# Optional notifications still come from matrix-bot replies/logs.

# Safe defaults. docker-compose.yml also sets these; keep here for visibility.
MATRIX_FUNDED_SYMBOLS=XLMUSDT,ADAUSDT
MATRIX_FUNDED_STRATEGIES=wolfe_channel
MATRIX_FUNDED_STATUSES=accepted
MATRIX_FUNDED_RISK_USDT=7.5
MATRIX_FUNDED_MAX_TOTAL_OPEN_RISK_USDT=15
MATRIX_FUNDED_MAX_OPEN_POSITIONS=2
MATRIX_FUNDED_MAX_SYMBOL_POSITIONS=1
MATRIX_FUNDED_ACCOUNT_EQUITY_FLOOR=4500
MATRIX_FUNDED_ACCOUNT_EQUITY_BUFFER_USDT=10
MATRIX_FUNDED_ACCOUNT_TARGET_EQUITY=5300
MATRIX_FUNDED_MAX_RISK_MULTIPLIER=1.05
