# Funded Wolfe Matrix sidecar credentials.
# Copy to bot/.env.funded and fill in the funded Bybit account keys locally.

# Funded account API credentials
RL_BYBIT_API_KEY=
RL_BYBIT_API_SECRET=

# This is a real Bybit funded/live account, not Bybit demo.
RL_BYBIT_DEMO=false

# Keep false until you have verified the container starts with the correct
# equity, filters, and risk caps in the logs.
RL_TRADING_ENABLED=false

# Telegram notifications for this funded lane. Leave blank to disable.
RL_TELEGRAM_BOT_TOKEN=
RL_TELEGRAM_CHAT_ID=

# Optional overrides. docker-compose.yml already sets the same safe defaults.
RL_DEFAULT_RISK_USDT=7.5
RL_MAX_RISK_USDT=7.5
RL_MAX_TOTAL_OPEN_RISK_USDT=15
RL_MAX_ACTIVE_TRADES=2
RL_MAX_SYMBOL_ACTIVE_TRADES=1
RL_ACCOUNT_EQUITY_FLOOR=4500
RL_ACCOUNT_EQUITY_BUFFER_USDT=10
RL_ACCOUNT_TARGET_EQUITY=5300

