# ===========================================================================
# wolfe-dca-bot — STANDALONE Wolfe DCA runner (SEPARATE Bybit Demo account)
# Copy to bot/.env.dca and fill in the keys. This is the ONLY env_file for the
# wolfe-dca-bot service, so it MUST carry its own API credentials — that way it
# can never accidentally use the production mm-bot account.
# ===========================================================================

# --- SEPARATE Bybit DEMO account (create a 2nd demo account / API key) -------
WOLFE_DCA_BYBIT_API_KEY=your_SECOND_demo_api_key_here
WOLFE_DCA_BYBIT_API_SECRET=your_SECOND_demo_api_secret_here
WOLFE_DCA_BYBIT_DEMO=true
# WOLFE_DCA_LIVE_CONFIRM=false        # must be true to trade with BYBIT_DEMO=false (don't)

# --- Account position mode --------------------------------------------------
# true = hedge (long positionIdx=1, short=2); false = one-way (0). Auto-detected
# at startup from your account; this is just the hint.
WOLFE_DCA_HEDGE_MODE=true

# --- Execution / risk -------------------------------------------------------
WOLFE_DCA_TRADING_ENABLED=true        # false = signal + ledger only (no orders)
WOLFE_DCA_RISK_PCT=0.005              # per-leg risk as a fraction of equity (~0.5%/R)
WOLFE_DCA_MAX_CONCURRENT=5            # max simultaneous Wolfe-DCA positions
# WOLFE_DCA_K=0.25                    # combined stop = SL - k*R (default reads config)
# WOLFE_DCA_MAX_HOLD_BARS=144         # 5m bars before timeout-close (default reads config)
# WOLFE_DCA_POLL_SECONDS=10           # position-monitor poll interval

# --- Symbols (optional) -----------------------------------------------------
# Leave blank to trade ALL symbols in the DCA config (recommended). Or restrict:
# WOLFE_DCA_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# --- Telegram alerts (set both to receive entry / leg2-fill / exit messages) -
# Leave blank to disable. Use your bot token and the target chat/channel id
# (for a supergroup topic, "<chat_id>_<thread_id>"). Without these, the bot still
# logs everything to docker logs + bot/logs_dca/wolfe_dca_ledger.jsonl.
WOLFE_DCA_TELEGRAM_BOT_TOKEN=
WOLFE_DCA_TELEGRAM_CHAT_ID=

# Config path, ledger path, and LOG_DIR are set in docker-compose.yml under the
# wolfe-dca-bot service, so this file only needs the account keys + risk knobs above.
